<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/AppTheme">
        <!--
            🔴 세로로 고정한다 — 거치대에 세워 둔 폰이 주행 중 흔들려 가로로 돌면
            운전 중에 화면을 다시 잡아야 한다. 관제탑은 세로 한 벌만 그린다.
        -->
        <activity
            android:screenOrientation="portrait"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- GPS 위치 추적 (관제탑 GPS 마스터) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- 포그라운드 서비스 (백그라운드 GPS 추적 유지) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- 화면 켜짐 유지 (운전 중 대시보드 꺼지지 않도록) -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- 네이티브 진동 피드백 (꿀콜/똥콜 알림) -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- 📞 누르면 바로 걸기 (DirectCallPlugin) — 없으면 다이얼러만 열려 한 번 더 눌러야 한다 -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
</manifest>
