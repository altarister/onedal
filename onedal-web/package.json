{
  "name": "onedal-web-workspace",
  "private": true,
  "scripts": {
    "dev:server": "pnpm --filter server dev",
    "dev:client": "pnpm --filter client-app dev",
    "dev:logbook": "pnpm --filter logbook dev",
    "dev": "node scripts/dev-preflight.mjs && { trap 'kill 0' INT TERM HUP; pnpm run dev:server & pnpm run dev:client & pnpm run dev:logbook & wait; }",
    "dev:fresh": "node scripts/reset-calls.mjs && pnpm run dev",
    "reset:calls": "node scripts/reset-calls.mjs",
    "audit:socket": "node scripts/audit-socket-contract.mjs",
    "scenario": "node scripts/scenario.mjs",
    "e2e:app": "node scripts/appLoop.mjs",
    "lifecycle": "node scripts/lifecycle.mjs",
    "map": "node scripts/map-flow.mjs",
    "audit:dead": "node scripts/audit-dead.mjs",
    "audit:docs": "node scripts/audit-docs.mjs",
    "rehearsal": "node scripts/rehearsal.mjs",
    "ledger": "node scripts/ledger.mjs",
    "track": "node scripts/track.mjs",
    "options": "node scripts/options.mjs",
    "reach": "node scripts/reach.mjs",
    "reach:sweep": "node scripts/reach-sweep.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
